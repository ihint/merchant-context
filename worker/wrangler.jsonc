{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "merchant-context-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-03",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "vars": {
    "X402_NETWORK": "base"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "MerchantContextMcp",
        "class_name": "MerchantContextMcp"
      }
    ]
  },
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["MerchantContextMcp"]
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "d1_databases": [
    {
      "binding": "USAGE_DB",
      "database_name": "merchant-context-usage",
      "database_id": "f82c080f-d1f1-4413-b67a-2e960aa1d388",
      "remote": true
    }
  ]
}
